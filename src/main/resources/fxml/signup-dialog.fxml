<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="14"
      prefWidth="380"
      styleClass="signup-card">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <Label text="Create your member account" styleClass="modal-title"/>
    <Label text="Your request will be reviewed by a librarian before activation."
           wrapText="true"
           styleClass="modal-subtitle"/>
    <TextField fx:id="fullNameField" promptText="Full Name" styleClass="input"/>
    <TextField fx:id="emailField" promptText="Email" styleClass="input"/>
    <PasswordField fx:id="passwordField" promptText="Password" styleClass="input"/>
    <Label fx:id="errorLabel" wrapText="true" styleClass="status-label"/>
</VBox>
